# Pulse environment variables.
#
# Copy to .env.local and fill in the values from your Supabase project settings.
# .env.local is ignored by git and must never be committed.

# Public Supabase configuration.
# Safe to expose to the browser: every request is still governed by row level
# security, so the anon key alone grants no access to another student's data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase configuration.
#
# The service role key BYPASSES row level security. Keep it out of any file the
# browser can reach, never prefix it with NEXT_PUBLIC_, and rotate it if it is
# ever exposed. Only scheduled jobs and trusted server code should use it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set when the server should reach Supabase on a different host than
# the browser does. Falls back to NEXT_PUBLIC_SUPABASE_URL when unset.
# SUPABASE_URL=https://your-project.supabase.co
