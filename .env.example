# Pulse environment variables.
#
# Copy this file to apps/web/.env.local and fill in the values from your
# Supabase project settings. .env.local is ignored by git and must never be
# committed.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe to expose to the browser: it
# identifies the project and nothing more. Row level security still governs
# every request, so this key alone grants no access to another student's data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
