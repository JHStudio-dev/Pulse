{
  "manifest_version": 3,
  "name": "Pulse Campus Companion",
  "version": "0.1.0",
  "description": "Local campus sync feasibility companion for Pulse.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://campus.ujcv.edu.hn/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://campus.ujcv.edu.hn/*"],
      "js": ["content.js"]
    }
  ]
}
